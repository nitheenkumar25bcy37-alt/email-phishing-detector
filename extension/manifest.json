{
  "manifest_version": 3,
  "name": "NETRA-Mail Shield",
  "version": "3.1.0",
  "description": "Real-time Gmail email threat detection powered by NETRA-Mail.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NETRA-Mail Shield"
  }
}