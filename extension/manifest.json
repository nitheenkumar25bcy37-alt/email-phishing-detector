{
  "manifest_version": 3,
  "name": "Agentic MX Phishing Detector",
  "version": "1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
