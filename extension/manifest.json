{
  "manifest_version": 3,
  "name": "Agentic MX - AI Email Threat Hunter",
  "version": "2.0.0",
  "description": "Real-time zero-click email threat scoring, BEC detection, and forensics.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://email-phishing-detector-1-z4wj.onrender.com/*",
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
